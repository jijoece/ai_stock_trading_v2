# Sentinel .env fixture for the pre-step 06 .env-suppression proof.
#
# FAKE VALUES ONLY. These are not credentials, authenticate nothing, and have
# never corresponded to any account. The sentinel token is deliberately
# unique so the spike can detect whether this file's contents ever reach the
# process environment or a LumiBot config object.
#
# run_dotenv_sentinel.sh copies this file to `.env` inside a disposable
# working directory. It is committed under this name (not `.env`) because the
# repository's .gitignore excludes `.env`, and because a file named `.env` in
# the source tree would be a hazard in its own right.
ALPACA_API_KEY=SENTINEL-DOTENV-7f3a9c21e4b8-ALPACA-KEY
ALPACA_API_SECRET=SENTINEL-DOTENV-7f3a9c21e4b8-ALPACA-SECRET
ALPACA_IS_PAPER=true
